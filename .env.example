# TrustEdge Agent ingest API (required — no hardcoded default).
# Local API example:
TRUSTEDGE_AGENT_API_URL=http://127.0.0.1:8080
# Remote example (replace with your host):
# TRUSTEDGE_AGENT_API_URL=https://your-ingest.example

# Required when the API enforces enroll on POST /v1/register.
# Provide via your secrets manager / server config — do not commit real tokens.
TRUSTEDGE_AGENT_ENROLL_TOKEN=

# Batch + zstd are on by default (supported by trustedge-agent-api).
# For older single-event images use: make run-agent-legacy
# TRUSTEDGE_AGENT_COMPRESS=0
# TRUSTEDGE_AGENT_BATCH=0
# TRUSTEDGE_AGENT_PROCESS_INTERVAL=0

# Offline event ring (persisted next to state file by default)
# TRUSTEDGE_AGENT_EVENT_QUEUE_CAPACITY=4096
# TRUSTEDGE_AGENT_EVENT_RETRY_MAX=60

# Logging / status
# TRUSTEDGE_AGENT_LOG_FORMAT=json
# TRUSTEDGE_AGENT_METRICS_INTERVAL=5m

# Set to 1 in production (requires https:// API URL + enroll token)
# TRUSTEDGE_AGENT_PRODUCTION=1
TRUSTEDGE_AGENT_NETWORK_DEBOUNCE=2
# Public IP for network_summary (optional). Set to "off" to disable outbound lookup.
# TRUSTEDGE_AGENT_PUBLIC_IP_URL=off
