TRUSTTWIN_API_URL=http://127.0.0.1:8080
TRUSTTWIN_ENROLL_TOKEN=
# Set to 1 in production (requires https:// API URL + enroll token on agent and API)
# TRUSTTWIN_PRODUCTION=1
TRUSTTWIN_NETWORK_DEBOUNCE=2
# Public IP for network_summary (default: ipify). Set to "off" to disable outbound lookup.
# TRUSTTWIN_PUBLIC_IP_URL=https://api.ipify.org?format=json
TRUSTTWIN_LISTEN=:8080
TRUSTTWIN_DATA_DIR=data
# Optional: same Redis as TrustEdge for live twin graph
# TRUSTTWIN_REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0
