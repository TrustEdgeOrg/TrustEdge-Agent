TRUSTEDGE_AGENT_API_URL=http://127.0.0.1:8080
TRUSTEDGE_AGENT_ENROLL_TOKEN=
# Set to 1 in production (requires https:// API URL + enroll token on agent and API)
# TRUSTEDGE_AGENT_PRODUCTION=1
TRUSTEDGE_AGENT_NETWORK_DEBOUNCE=2
# Public IP for network_summary (default: ipify). Set to "off" to disable outbound lookup.
# TRUSTEDGE_AGENT_PUBLIC_IP_URL=https://api.ipify.org?format=json
TRUSTEDGE_AGENT_LISTEN=:8080
TRUSTEDGE_AGENT_DATA_DIR=data
# Production (TRUSTEDGE_AGENT_PRODUCTION=1): no devices.json/events.jsonl; requires Redis + enroll token.
# Override disk writes in dev: TRUSTEDGE_AGENT_PERSIST_FILES=0|1
# Optional: same Redis as TrustEdge for live twin graph
# TRUSTEDGE_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0
# Optional: publish ingested events to Kafka/Redpanda (unset = disabled)
# KAFKA_BROKERS=redpanda:9092
# KAFKA_TOPIC=trustedge.agent.events
